  "@id": "https://brickyard.biobricks.ai/brick/guide-to-pharmacology",
  "dcterms:title": "IUPHAR/BPS Guide to PHARMACOLOGY (GtoPdb)",
  "dcterms:description": "Expert-curated database of pharmacological targets and their ligands. Contains drug-target interactions, receptor families, ion channels, enzymes, transporters, and approved drug data with cross-references to UniProt, HGNC, and ChEMBL.",
  "dcterms:license": "https://creativecommons.org/licenses/by-sa/4.0/",
  "biobricks:reviewed": false,
