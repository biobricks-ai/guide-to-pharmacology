  "agenticPriority": 2,
  "agenticPriorityLabel": "low",
  "schema:description": "This BioBrick contains data extracted from the Guide to Pharmacology (GtP) database, providing comprehensive information on pharmacological targets (e.g., receptors, enzymes, ion channels) and their ligands, including approved drugs and endogenous molecules. It includes detailed drug-target interaction data, target family classifications, and mappings to UniProt and HGNC identifiers, enabling applications in drug discovery, toxicology, and pharmacology research.",
  "tables": {
    "GtP_to_HGNC_mapping": {
      "@type": "csvw:Table",
      "@id": "https://brickyard.biobricks.ai/brick/guide-to-pharmacology/table/GtP_to_HGNC_mapping",
      "dcterms:description": "This table provides a mapping between Guide to Pharmacology (GtP) receptor entries and their corresponding HGNC (HUGO Gene Nomenclature Committee) identifiers, including gene symbols, IDs, and links to both the GtP and HGNC resources. It serves as a reference for cross-referencing receptor nomenclature between the two databases.",
      "tableSchema": {
        "@type": "csvw:Schema",
        "columnCount": 5,
        "columns": [
          {
            "@type": "csvw:Column",
            "columnName": "hgnc_symbol",
            "datatype": "String",
            "dcterms:description": "The official gene symbol assigned by the HUGO Gene Nomenclature Committee (HGNC).",
            "nullCount": 0,
            "uniqueCount": 100,
            "sampleValues": [
              "AAK1",
              "AATK",
              "ABAT",
              "ABCA1",
              "ABCA10"
            ]
          },
          {
            "@type": "csvw:Column",
            "columnName": "hgnc_id",
