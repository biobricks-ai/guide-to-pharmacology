            "nullCount": 0,
            "uniqueCount": 100,
            "sampleValues": [
              "19679",
              "21",
              "23",
              "29",
              "30"
            ]
          },
          {
            "@type": "csvw:Column",
            "columnName": "iuphar_name",
            "datatype": "String",
            "dcterms:description": "The preferred name of the target as defined by the International Union of Basic and Clinical Pharmacology (IUPHAR).",
            "nullCount": 0,
            "uniqueCount": 100,
            "sampleValues": [
              "AP2 associated kinase 1",
